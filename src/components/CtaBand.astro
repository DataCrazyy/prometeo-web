---
import Icon from './Icon.astro';
import { bookingLink, site } from '../data/site';
import { url } from '../lib/url';
interface Props { title?: string; lead?: string; tema?: string }
const {
  title = '¿Listo para que tus datos trabajen para ti?',
  lead = 'Cuéntanos qué decisión necesitas tomar y te proponemos el camino: un proyecto, un curso o datos de precios.',
  tema,
} = Astro.props;
const contactHref = url(tema ? `contacto/?tema=${tema}` : 'contacto/');
---
<section class="cta" aria-labelledby="cta-title">
  <div class="container inner reveal">
    <h2 id="cta-title">{title}</h2>
    <p>{lead}</p>
    <div class="btn-row center">
      <a class="btn btn-white" href={bookingLink(tema)}><Icon name="calendar" />Agendar reunión</a>
      <a class="btn btn-ghost" href={contactHref}><Icon name="mail" />Escríbenos</a>
    </div>
    <p class="small"><a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
</section>

<style>
  .cta { background: linear-gradient(135deg, var(--ink) 0%, var(--purple) 50%, var(--ink) 100%); padding: 100px 0; color: #fff; text-align: center; position: relative; overflow: hidden; }
  .inner { position: relative; }
  h2 { font-size: clamp(28px, 4vw, 48px); font-weight: 800; letter-spacing: -1.5px; max-width: 760px; margin: 0 auto 18px; }
  p { font-size: 18px; color: rgba(255,255,255,.8); max-width: 600px; margin: 0 auto 36px; }
  .small { margin: 24px auto 0; font-size: 15px; }
  .small a { color: #fff; display: inline-block; padding: 10px 6px; }
</style>
