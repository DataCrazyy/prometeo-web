---
// Sello "Con certificado": roseta dorada con cintas, para cursos que entregan certificado.
interface Props { size?: number; label?: string }
const { size = 64, label = 'Con certificado' } = Astro.props;
const uid = `cs${Math.random().toString(36).slice(2, 7)}`;
// Borde festoneado de la roseta (20 puntas)
const pts = Array.from({ length: 40 }, (_, i) => {
  const r = i % 2 ? 22.5 : 25.5, a = (i / 40) * Math.PI * 2 - Math.PI / 2;
  return `${(32 + r * Math.cos(a)).toFixed(2)},${(28 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
---
<span class="cert" title={label}>
  <svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={label}>
    <defs>
      <linearGradient id={`${uid}g`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#FFD43B" /><stop offset=".55" stop-color="#FFA94D" /><stop offset="1" stop-color="#F76707" />
      </linearGradient>
    </defs>
    <path d="M20 42 L13 61 L20 57 L24 63 L30 47 Z" fill="#E8590C" />
    <path d="M44 42 L51 61 L44 57 L40 63 L34 47 Z" fill="#C2410C" />
    <polygon points={pts} fill={`url(#${uid}g)`} />
    <circle cx="32" cy="28" r="17" fill="none" stroke="#fff" stroke-opacity=".85" stroke-width="1.6" stroke-dasharray="2 2.4" />
    <path d="M24.5 28.5 L30 34 L40.5 22.5" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="cert-l">{label}</span>
</span>

<style>
  .cert { display: inline-flex; flex-direction: column; align-items: center; gap: 4px; flex: none; }
  .cert svg { filter: drop-shadow(0 4px 10px rgba(247, 103, 7, .35)); transition: transform .4s var(--ease-out); }
  .cert:hover svg { transform: rotate(-8deg) scale(1.06); }
  .cert-l { font-size: 11.5px; font-weight: 700; letter-spacing: .02em; color: #FFC078; white-space: nowrap; }
</style>
