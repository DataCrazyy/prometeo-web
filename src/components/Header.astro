---
import Logo from './Logo.astro';
import Mark from './Mark.astro';
import type { Brand } from '../lib/brandIcons';
import Icon from './Icon.astro';
import { nav, bookingLink } from '../data/site';
import { url } from '../lib/url';
interface Props { brand?: Brand }
const { brand = 'prometeo' } = Astro.props;
const current = Astro.url.pathname;
const iconOf = (key: string): Brand => (['consulting', 'academy', 'talks'].includes(key) ? key : 'prometeo') as Brand;
const isActive = (href: string) => current.startsWith(url(href));
---
<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href={url('')} class="brand" aria-label="Prometeo, ir al inicio">
      <Logo brand={brand} />
    </a>
    <button class="toggle" type="button" aria-expanded="false" aria-controls="menu" data-toggle>
      <span class="sr-only">Abrir menú</span>
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
    </button>
    <nav id="menu" class="menu" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li><a href={url(item.href)} class={`l-${item.key}`} aria-current={isActive(item.href) ? 'page' : undefined}><span class="ico" aria-hidden="true"><Mark brand={iconOf(item.key)} size={20} variant="white" class="ic-w" /><Mark brand={iconOf(item.key)} size={20} class="ic-c" /></span>{item.label}</a></li>
        ))}
        <li class="sep" aria-hidden="true"></li>
        <li>
          <a href={url('precios-claros/')} class="l-precio pj-link" aria-current={isActive('precios-claros/') ? 'page' : undefined}>
            <span class="ico" aria-hidden="true"><Mark brand="precio" size={20} variant="white" class="ic-w" /><Mark brand="precio" size={20} class="ic-c" /></span>Precios Claros <span class="by">by prometeo</span>
          </a>
        </li>
      </ul>
      <a class="btn btn-primary nav-cta" href={bookingLink()}>Agendar reunión</a>
    </nav>
  </div>
</header>

<style>
  .nav { view-transition-name: site-nav; position: fixed; inset: 0 0 auto 0; z-index: 50; transition: background var(--trans), box-shadow var(--trans), transform .35s var(--ease-out); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 76px; }
  .brand { text-decoration: none; }
  .menu { display: flex; align-items: center; gap: 24px; }
  .menu ul { list-style: none; display: flex; align-items: center; gap: 2px; }
  .menu ul a { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 999px; font-size: 15px; white-space: nowrap; font-weight: 500; text-decoration: none; color: rgba(255,255,255,.86); transition: color var(--trans), background var(--trans); }
  .menu ul a:hover { color: #fff; background: rgba(255,255,255,.1); }
  .ico { display: inline-flex; width: 20px; height: 20px; flex: none; }
  .ico :global(.ic-c) { display: none; }
  .nav.scrolled .ico :global(.ic-w), .nav.open .ico :global(.ic-w) { display: none; }
  .nav.scrolled .ico :global(.ic-c), .nav.open .ico :global(.ic-c) { display: block; }
  .nav:not(.scrolled):not(.open) :global(.b-consulting .sub) { color: #B39DFF; }
  .nav:not(.scrolled):not(.open) :global(.b-academy .sub) { color: #91A7FF; }
  .nav:not(.scrolled):not(.open) :global(.b-talks .sub) { color: #FFA94D; }
  .nav:not(.scrolled):not(.open) :global(.logo .by) { color: #63E6BE; }
  .menu ul a[aria-current='page'] { color: #fff; background: rgba(255,255,255,.14); }
  .sep { width: 1px; height: 22px; background: rgba(255,255,255,.22); margin: 0 8px; }
  .by { font-size: 11px; font-weight: 600; letter-spacing: .3px; opacity: .7; }
  .nav-cta { padding: 11px 22px; min-height: 44px; font-size: 14px; white-space: nowrap; }
  .toggle { display: none; background: none; border: 0; color: #fff; width: 48px; height: 48px; border-radius: 12px; cursor: pointer; align-items: center; justify-content: center; }
  .toggle :global(.i-close) { display: none; }

  .nav:not(.scrolled) :global(.word) { color: #fff; }

  .nav.scrolled { background: rgba(255,255,255,.82); backdrop-filter: saturate(180%) blur(18px); -webkit-backdrop-filter: saturate(180%) blur(18px); box-shadow: 0 1px 0 rgba(30,27,46,.08); }
  .nav.scrolled .menu ul a { color: var(--charcoal); }
  .nav.scrolled .menu ul a:hover { background: var(--purple-light); }
  .nav.scrolled .menu ul a[aria-current='page'] { background: var(--purple-light); color: var(--purple-dark); }
  .nav.scrolled .sep { background: rgba(30,27,46,.15); }
  .nav.scrolled .toggle { color: var(--charcoal); }
  .nav.hidden { transform: translateY(-100%); }

  @media (max-width: 1240px) {
    .toggle { display: inline-flex; }
    .menu {
      position: absolute; top: 76px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 16px;
      background: #fff; padding: 12px 24px 24px; box-shadow: 0 18px 40px rgba(30,27,46,.15);
      display: none;
    }
    .menu ul { flex-direction: column; align-items: stretch; }
    .ico :global(.ic-w) { display: none; } .ico :global(.ic-c) { display: block; }
    .menu ul a, .nav.scrolled .menu ul a { color: var(--charcoal); padding: 15px 10px; font-size: 17px; border-radius: 12px; }
            .menu ul a[aria-current='page'], .nav.scrolled .menu ul a[aria-current='page'] { background: var(--purple-light); color: var(--purple-dark); }
    .sep { width: auto; height: 1px; margin: 8px 0; background: rgba(30,27,46,.1); }
    .nav.open .menu { display: flex; }
    .nav.open { background: #fff; transform: none; }
    .nav.open .toggle { color: var(--charcoal); }
    .nav.open :global(.word) { color: var(--charcoal); }
    .nav.open :global(.i-open) { display: none; }
    .nav.open :global(.i-close) { display: block; }
    .nav-cta { width: 100%; min-height: 50px; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const btn = document.querySelector<HTMLButtonElement>('[data-toggle]');
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    nav?.classList.toggle('scrolled', y > 24);
    // Se oculta al bajar y reaparece al subir (como apple.com)
    if (!nav?.classList.contains('open')) nav?.classList.toggle('hidden', y > 400 && y > lastY);
    lastY = y;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const close = () => { nav?.classList.remove('open'); btn?.setAttribute('aria-expanded', 'false'); if (btn) btn.querySelector('.sr-only')!.textContent = 'Abrir menú'; };
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
  });
  nav?.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav?.classList.contains('open')) { close(); btn?.focus(); } });
</script>
