---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, bookingLink } from '../data/site';
import { url } from '../lib/url';
const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(url(href));
---
<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href={url('')} class="brand" aria-label="Prometeo, ir al inicio">
      <Logo />
    </a>
    <button class="toggle" type="button" aria-expanded="false" aria-controls="menu" data-toggle>
      <span class="sr-only">Abrir menú</span>
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
    </button>
    <nav id="menu" class="menu" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href={url('#alianzas')}>Alianzas</a></li>
      </ul>
      <a class="btn btn-primary nav-cta" href={bookingLink()} target="_blank" rel="noopener">Agendar reunión</a>
    </nav>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: background var(--trans), box-shadow var(--trans); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 76px; }
  .brand { text-decoration: none; }
  .menu { display: flex; align-items: center; gap: 28px; }
  .menu ul { list-style: none; display: flex; gap: 4px; }
  .menu ul a { display: block; padding: 10px 14px; border-radius: 10px; font-size: 15px; font-weight: 500; text-decoration: none; color: rgba(255,255,255,.88); transition: color var(--trans), background var(--trans); }
  .menu ul a:hover { color: #fff; background: rgba(255,255,255,.08); }
  .menu ul a[aria-current='page'] { color: #fff; box-shadow: inset 0 -2px 0 var(--purple-soft); border-radius: 0; }
  .nav-cta { padding: 11px 22px; min-height: 44px; font-size: 14px; }
  .toggle { display: none; background: none; border: 0; color: #fff; width: 48px; height: 48px; border-radius: 12px; cursor: pointer; align-items: center; justify-content: center; }
  .toggle :global(.i-close) { display: none; }

  /* Logo blanco sobre el hero */
  .nav:not(.scrolled) :global(.word) { color: #fff; }

  .nav.scrolled { background: rgba(255,255,255,.96); backdrop-filter: blur(12px); box-shadow: 0 2px 20px rgba(30,27,46,.08); }
  .nav.scrolled .menu ul a { color: var(--charcoal); }
  .nav.scrolled .menu ul a:hover { color: var(--purple-dark); background: var(--purple-light); }
  .nav.scrolled .menu ul a[aria-current='page'] { color: var(--purple-dark); box-shadow: inset 0 -2px 0 var(--purple); }
  .nav.scrolled .toggle { color: var(--charcoal); }

  @media (max-width: 960px) {
    .toggle { display: inline-flex; }
    .menu {
      position: absolute; top: 76px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 16px;
      background: #fff; padding: 16px 24px 24px; box-shadow: 0 18px 40px rgba(30,27,46,.15);
      display: none;
    }
    .menu ul { flex-direction: column; }
    .menu ul a, .nav.scrolled .menu ul a { color: var(--charcoal); padding: 14px 8px; font-size: 17px; border-bottom: 1px solid var(--gray-light); border-radius: 0; }
    .nav.open .menu { display: flex; }
    .menu ul a[aria-current='page'], .nav.scrolled .menu ul a[aria-current='page'] { color: var(--purple-dark); box-shadow: inset 3px 0 0 var(--purple); padding-left: 14px; }
    .nav.open { background: #fff; }
    .nav.open .toggle { color: var(--charcoal); }
    .nav.open :global(.word) { color: var(--charcoal); }
    .nav.open :global(.i-open) { display: none; }
    .nav.open :global(.i-close) { display: block; }
    .nav-cta { width: 100%; min-height: 50px; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const btn = document.querySelector<HTMLButtonElement>('[data-toggle]');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
  });
  nav?.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', () => {
    nav.classList.remove('open'); btn?.setAttribute('aria-expanded', 'false');
  }));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) { nav.classList.remove('open'); btn?.setAttribute('aria-expanded', 'false'); btn?.focus(); }
  });
</script>
