---
import { waLink } from '../data/site';
---
<a class="fab" href={waLink()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" data-fab>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6a10.6 10.6 0 0 1-5.4-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.7 8.7 0 0 1-2.6-1.6 9.6 9.6 0 0 1-1.8-2.2c-.2-.3 0-.5.1-.7l.5-.6.3-.5a.6.6 0 0 0 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.4 14.4 0 0 0 5.5 4.9c2.1.8 2.9.9 3.4.8a3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.2-.3-.3-.6-.4z"/></svg>
  <span class="lbl">¿Hablamos?</span>
</a>

<style>
  .fab {
    position: fixed; right: 18px; bottom: 18px; z-index: 40;
    display: inline-flex; align-items: center; gap: 10px;
    height: 56px; padding: 0 14px; border-radius: 99px;
    background: #25D366; color: #0B3D22; text-decoration: none; font-weight: 700; font-size: 15px;
    box-shadow: 0 10px 28px rgba(0,0,0,.22);
    transition: transform var(--trans), box-shadow var(--trans), opacity .3s;
    view-transition-name: whatsapp-fab;
  }
  .fab:hover { color: #0B3D22; transform: translateY(-3px); box-shadow: 0 16px 36px rgba(0,0,0,.28); }
  .lbl { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width .35s var(--ease-out); }
  .fab:hover .lbl, .fab:focus-visible .lbl { max-width: 120px; padding-right: 4px; }
  .fab.away { opacity: 0; pointer-events: none; transform: translateY(12px); }
</style>

<script>
  // Se oculta cuando el pie de página está a la vista para no tapar los enlaces
  const fab = document.querySelector<HTMLElement>('[data-fab]');
  const foot = document.querySelector('footer');
  if (fab && foot && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => fab.classList.toggle('away', e.isIntersecting), { threshold: 0.05 }).observe(foot);
  }
</script>
