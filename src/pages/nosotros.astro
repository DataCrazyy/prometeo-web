---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Mark from '../components/Mark.astro';
import { stats } from '../data/site';
import { url } from '../lib/url';

// Fundadores: reemplaza los [corchetes] y agrega la foto en src/assets/team/ cuando la tengas
const founders = [
  {
    name: 'David Arostegui Enriquez', initials: 'DA', role: 'Cofundador · Consulting y Academy',
    bio: 'Más de cinco años convirtiendo datos en decisiones en consumo masivo, farmacia, bebidas y logística. Hoy lidera proyectos comerciales y de transformación digital; antes, como Data Analyst en Farmacorp, diseñó y automatizó los dashboards de ventas e inventario en Power BI.',
    skills: ['Power BI', 'DAX', 'SQL', 'Google Cloud', 'SAP'],
    exp: ['Alicorp', 'Farmacorp', 'Cervecería Boliviana Nacional', 'Grupo Venado', 'UAGRM (docente)'],
    linkedin: 'https://www.linkedin.com/in/davidarostegui/',
  },
  {
    name: 'Diego Omonte Cespedes', initials: 'DO', role: 'Cofundador · Academy y Tecnología',
    bio: 'Analista de categorías en consumo masivo y docente de posgrado: Power BI en la UAGRM y Python en la Universidad Católica Boliviana. Antes lideró el área de análisis de datos de Nexocorp, con proyectos de BI, Microsoft Fabric, big data y machine learning.',
    skills: ['Power BI', 'Microsoft Fabric', 'Python', 'SQL', 'Category management'],
    exp: ['Alicorp', 'Nexocorp', 'UAGRM', 'Universidad Católica Boliviana'],
    linkedin: 'https://www.linkedin.com/in/diego-omonte-278365224/',
  },
];

// Línea de tiempo de "Nuestra historia" (fechas reales; edítalas aquí)
const road = [
  { year: '2024', brand: 'academy', t: 'Primera capacitación in-company', d: 'Power BI para el equipo de Nexocorp.' },
  { year: '2025', brand: 'academy', t: 'Capacitación en Industrias Venado', d: 'Power BI aplicado a su operación comercial.' },
  { year: '2026', brand: 'academy', t: 'Docencia en dos universidades', d: 'Los dos somos docentes en la UAGRM, y Diego enseña Python en la Universidad Católica Boliviana.' },
  { year: 'Hoy', brand: 'prometeo', t: 'Nace Prometeo', d: 'Consulting, Academy y Talks bajo una misma marca, y Precio Justo como proyecto propio.', now: true },
] as const;

const values = [
  { icon: 'target', t: 'Datos con propósito', d: 'Cada dashboard responde a una decisión concreta. Si no ayuda a decidir, no lo construimos.' },
  { icon: 'graduation', t: 'Enseñar haciendo', d: 'Lo que enseñamos en Academy sale de proyectos reales, y los proyectos mejoran con lo que aprendemos en clase.' },
  { icon: 'handshake', t: 'Cercanía', d: 'Trabajamos al lado de tu equipo, hablamos claro y respondemos rápido.' },
  { icon: 'pin', t: 'Hecho en Bolivia', d: 'Conocemos cómo trabajan las empresas de aquí, sus sistemas y sus tiempos.' },
] as const;
---
<Base title="Nosotros" description="Conoce a Prometeo: quiénes somos, por qué nos llamamos así y cómo trabajamos con datos en Santa Cruz de la Sierra, Bolivia.">
  <section class="page-hero n-hero" aria-labelledby="h">
    <div class="container">
      <p class="badge-line"><Icon name="users" />Nosotros</p>
      <h1 id="h" data-split>Llevamos el fuego del conocimiento a <span class="gradient-text">tus datos</span></h1>
      <p class="lead reveal">Somos un equipo boliviano que implementa Business Intelligence, enseña Power BI y construye productos de datos. Nos mueve que más personas decidan con información.</p>
    </div>
  </section>

  <section class="section story" aria-labelledby="story-t">
    <div class="container">
      <SectionHead id="story-t" center eyebrow="Nuestra historia" icon="book" title="Cómo nació Prometeo" />

      <article class="chapter">
        <div class="ch-side reveal"><span class="ch-n" aria-hidden="true">01</span><span class="ch-k">El problema</span></div>
        <div class="ch-body reveal">
          <h3>Todo empezó con un reporte en Excel.</h3>
          <p>Trabajando en empresas de consumo masivo, farmacia y bebidas vimos lo mismo una y otra vez: equipos que pasaban días armando reportes a mano, gerentes que decidían con cifras de la semana pasada y datos valiosos guardados en sistemas que nadie consultaba.</p>
          <div class="ch-quote">Los datos estaban ahí. Faltaba encenderlos.</div>
        </div>
      </article>

      <article class="chapter">
        <div class="ch-side reveal"><span class="ch-n" aria-hidden="true">02</span><span class="ch-k">Dos caminos</span></div>
        <div class="ch-body reveal">
          <h3>Empresas parecidas, áreas distintas, los mismos problemas.</h3>
          <div class="paths">
            <div class="path"><span class="who">David</span><p>Desde los proyectos comerciales y de transformación digital: diseñó y automatizó los dashboards de ventas e inventario en Power BI para que los equipos dejaran de armar reportes a mano.</p></div>
            <div class="path"><span class="who">Diego</span><p>Desde el análisis de categorías y de datos: lideró el área de análisis de datos en Nexocorp con proyectos de BI y Microsoft Fabric, y enseña Python en la Universidad Católica Boliviana.</p></div>
          </div>
          <div class="shared"><Mark brand="academy" size={30} /><p><strong>Y los dos somos docentes de la UAGRM.</strong> En el aula confirmamos lo que veíamos en las empresas: una solución de datos funciona de verdad solo cuando el equipo sabe usarla. Por eso Prometeo hace las dos cosas.</p></div>
        </div>
      </article>

      <article class="chapter">
        <div class="ch-side reveal"><span class="ch-n" aria-hidden="true">03</span><span class="ch-k">El nombre</span></div>
        <div class="ch-body ch-name reveal">
          <div class="why-mark" data-parallax="8"><Mark size={200} class="wm" label="Símbolo de Prometeo: una llama formada por barras de datos" /></div>
          <div>
            <h3>El que compartió el fuego.</h3>
            <p>En el mito griego, Prometeo tomó el fuego de los dioses y se lo dio a las personas. Para nosotros, ese fuego es el conocimiento: los datos no deberían quedarse en manos de unos pocos especialistas.</p>
            <p><strong>Nuestro símbolo</strong> es una llama hecha de barras de datos, un gráfico que se enciende. La chispa de arriba es el conocimiento que pasa de mano en mano, y está en el logo de cada una de nuestras líneas.</p>
          </div>
        </div>
      </article>

      <article class="chapter">
        <div class="ch-side reveal"><span class="ch-n" aria-hidden="true">04</span><span class="ch-k">El camino</span></div>
        <div class="ch-body reveal">
          <h3>Lo que hemos encendido hasta hoy.</h3>
          <ol class="road">
            {road.map((r) => (
              <li class:list={[{ now: r.now }]}>
                <span class="yr">{r.year}</span>
                <span class="rd-ico"><Mark brand={r.brand} size={26} /></span>
                <div><strong>{r.t}</strong><p>{r.d}</p></div>
              </li>
            ))}
          </ol>
        </div>
      </article>

      <article class="chapter">
        <div class="ch-side reveal"><span class="ch-n" aria-hidden="true">05</span><span class="ch-k">Lo que viene</span></div>
        <div class="ch-body reveal">
          <h3>Que más personas decidan con datos.</h3>
          <p>Este año abrimos la cohorte <strong>Analista de datos con Power BI + Inteligencia Artificial</strong> y preparamos <strong>Prometeo Talks</strong>, un espacio de conferencias y videos para compartir lo que aprendemos. El fuego sigue pasando de mano en mano.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="team">
    <div class="container">
      <SectionHead id="team" center eyebrow="El equipo" icon="users" title="Quiénes están detrás" />
      <div class="grid grid-2 team">
        {founders.map((f) => (
          <article class="card person reveal">
            <div class="photo" aria-hidden="true"><span class="ini">{f.initials}</span></div>
            <div>
              <h3>{f.name}</h3>
              <p class="role">{f.role}</p>
              <p>{f.bio}</p>
              <div class="skills">{f.skills.map((k) => <span>{k}</span>)}</div>
              <p class="exp"><strong>Experiencia en:</strong> {f.exp.join(' · ')}</p>
              <a class="li" href={f.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={16} />Ver perfil en LinkedIn</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="val">
    <div class="container">
      <SectionHead id="val" center eyebrow="Cómo trabajamos" icon="handshake" title="Lo que nos guía" />
      <div class="grid grid-4">
        {values.map((v) => (
          <article class="card reveal" data-tilt>
            <div class="icon-chip"><Icon name={v.icon} /></div>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </article>
        ))}
      </div>
      <dl class="n-stats reveal">
        {stats.map((s) => <div><dd>{s.count !== null ? <span data-count={s.count} data-prefix={s.prefix}>{s.prefix}{s.count}</span> : s.text}</dd><dt>{s.label}</dt></div>)}
      </dl>
      <div class="n-links reveal">
        <a href={url('consulting/')} class="nl c"><Mark brand="consulting" size={20} />Prometeo Consulting</a>
        <a href={url('academy/')} class="nl a"><Mark brand="academy" size={20} />Prometeo Academy</a>
        <a href={url('talks/')} class="nl t"><Mark brand="talks" size={20} />Prometeo Talks</a>
        <a href={url('precio-justo/')} class="nl p"><Mark brand="precio" size={20} />Precio Justo by prometeo</a>
      </div>
    </div>
  </section>

  <CtaBand title="Conversemos sobre tus datos" lead="Un proyecto, un curso o solo una idea: escríbenos y te respondemos rápido." />
</Base>

<style>
  .story .chapter { display: grid; grid-template-columns: 220px 1fr; gap: 48px; padding: 56px 0; border-top: 1px solid #ECE8F6; }
  .story .chapter:first-of-type { border-top: 0; padding-top: 24px; }
  .ch-side { position: sticky; top: 110px; align-self: start; display: flex; flex-direction: column; gap: 6px; }
  .ch-n { font-family: var(--font-display); font-weight: 800; font-size: 88px; line-height: .9; letter-spacing: -4px; color: transparent; -webkit-text-stroke: 2px var(--purple); }
  .ch-k { font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--purple-dark); }
  .ch-body { max-width: 720px; }
  .ch-body h3 { font-size: clamp(26px, 3.4vw, 38px); letter-spacing: -1px; line-height: 1.12; margin-bottom: 16px; text-wrap: balance; }
  .ch-body p { font-size: 17px; line-height: 1.7; color: var(--gray-mid); }
  .ch-body p + p { margin-top: 12px; }
  .ch-quote { margin-top: 22px; font-family: var(--font-display); font-weight: 700; font-size: clamp(20px, 2.4vw, 26px); color: var(--purple-dark); padding-left: 20px; border-left: 3px solid var(--purple); }
  .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 4px 0 18px; }
  .path { background: var(--tint); border-radius: 18px; padding: 20px; }
  .path p { font-size: 15px !important; }
  .shared { display: flex; gap: 14px; align-items: flex-start; background: var(--ink); color: #fff; border-radius: 18px; padding: 18px 20px; }
  .shared p { color: rgba(255,255,255,.82) !important; font-size: 16px !important; }
  .shared strong { color: #fff; }
  .shared :global(svg) { flex: none; margin-top: 2px; }
  .who { display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--charcoal); margin-bottom: 6px; }
  .ch-name { display: grid; grid-template-columns: 200px 1fr; gap: 32px; align-items: center; max-width: 860px; }
  .road { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-direction: column; gap: 0; position: relative; }
  .road::before { content: ''; position: absolute; left: 83px; top: 18px; bottom: 18px; width: 2px; background: linear-gradient(var(--purple-pale), var(--purple)); }
  .road li { display: grid; grid-template-columns: 60px 48px 1fr; gap: 12px; align-items: start; padding: 12px 0; }
  .yr { font-family: var(--font-display); font-weight: 800; font-size: 20px; color: var(--purple-dark); padding-top: 10px; text-align: right; font-variant-numeric: tabular-nums; }
  .rd-ico { position: relative; z-index: 1; width: 46px; height: 46px; border-radius: 14px; background: #fff; box-shadow: var(--shadow-sm); display: flex; align-items: center; justify-content: center; }
  .road strong { display: block; font-size: 17px; color: var(--charcoal); padding-top: 4px; }
  .road p { font-size: 15px !important; margin-top: 2px; }
  .road li.now .rd-ico { background: var(--ink); box-shadow: 0 0 0 6px rgb(var(--accent-rgb) / .15); }
  .road li.now .yr { color: var(--purple); }
  @media (max-width: 860px) {
    .story .chapter { grid-template-columns: 1fr; gap: 14px; padding: 40px 0; }
    .ch-side { position: static; flex-direction: row; align-items: baseline; gap: 14px; }
    .ch-n { font-size: 56px; }
    .paths, .ch-name { grid-template-columns: 1fr; }
    .ch-name .why-mark { max-width: 180px; }
  }
  .n-hero .container { position: relative; z-index: 1; }
  .why-mark { aspect-ratio: 1; max-width: 200px; width: 100%; margin: 0 auto; padding: 32px; border-radius: 40px; background: var(--ink); display: flex; align-items: center; justify-content: center; }
  .why-mark :global(.wm) { width: 100%; height: 100%; }
  .person { display: flex; gap: 24px; align-items: flex-start; padding: 32px; }
  .photo { width: 120px; height: 120px; flex: none; border-radius: 28px; background: var(--hero-grad); color: #fff; display: flex; align-items: center; justify-content: center; }
  .ini { font-family: var(--font-display); font-weight: 800; font-size: 40px; letter-spacing: -1px; }
  .role { color: var(--purple-dark) !important; font-weight: 600; font-size: 14px !important; margin: 2px 0 10px; }
  .skills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .skills span { font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 99px; background: var(--purple-light); color: var(--purple-dark); }
  .exp { margin-top: 12px; font-size: 14px !important; }
  .exp strong { color: var(--charcoal); }
  .li { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; font-weight: 600; font-size: 14px; padding: 6px 0; }
  @media (max-width: 520px) { .person { flex-direction: column; } }
  .n-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin: 64px 0 0; text-align: center; padding: 36px; border-radius: var(--radius-lg); background: var(--hero-grad); color: #fff; }
  .n-stats dd { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 40px; letter-spacing: -1px; }
  .n-stats dt { font-size: 14px; color: rgba(255,255,255,.8); }
  .n-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 28px; }
  .nl { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 99px; border: 1px solid #E6E1F3; text-decoration: none; color: var(--charcoal); font-weight: 600; font-size: 14px; min-height: 44px; transition: background var(--trans); }
  .nl:hover { background: var(--tint); color: var(--charcoal); }
  .nl span { width: 9px; height: 9px; border-radius: 50%; }
  .nl.c span { background: var(--c-consulting); } .nl.a span { background: var(--c-academy); } .nl.t span { background: var(--c-talks); } .nl.p span { background: var(--c-precio); }
</style>
