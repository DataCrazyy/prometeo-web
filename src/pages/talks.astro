---
import Mark from '../components/Mark.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

const formats = [
  { icon: 'mic', t: 'Conferencias', d: 'Charlas con casos reales de datos e IA en empresas bolivianas.' },
  { icon: 'users', t: 'Eventos y meetups', d: 'Encuentros presenciales para conectar con la comunidad de datos.' },
  { icon: 'video', t: 'Videos y contenido', d: 'Tutoriales, entrevistas y resúmenes de cada evento.' },
] as const;
---
<Base theme="talks" title="Talks · Próximamente" description="Prometeo Talks: conferencias, eventos y videos sobre datos, IA aplicada y transformación digital en Bolivia. Únete a la lista de espera.">
  <section class="page-hero talks-hero" aria-labelledby="h">
    <div class="container talks-grid">
      <div>
        <p class="badge-line"><Mark brand="talks" size={22} />Prometeo Talks · Próximamente</p>
        <h1 id="h" data-split>Prometeo <span class="gradient-text">Talks</span></h1>
        <p class="lead">Conversaciones sobre datos, IA aplicada y transformación digital, con personas que lo están haciendo en Bolivia.</p>
      </div>
      <WaitlistForm />
    </div>
  </section>

  <section class="section" aria-labelledby="fm">
    <div class="container">
      <SectionHead id="fm" center eyebrow="Lo que viene" icon="sparkles" title="Tres formatos, una comunidad"
        lead="¿Quieres proponer un tema o dar una charla? Escríbenos desde la lista de espera." />
      <div class="grid grid-3 m-swipe">
        {formats.map((f) => (
          <article class="card reveal">
            <div class="icon-chip"><Icon name={f.icon} /></div>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .talks-hero { padding-bottom: 104px; }
  .talks-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 56px; align-items: center; position: relative; z-index: 1; }
  .talks-grid h1 { font-size: clamp(48px, 7vw, 88px); letter-spacing: -3px; }
</style>
