---
// Nombre anterior: Precio Justo. Redirige los enlaces viejos a /precios-claros/.
import { url } from '../lib/url';
const to = url('precios-claros/');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Precios Claros by prometeo</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
  </head>
  <body><p>Precio Justo ahora se llama <a href={to}>Precios Claros</a>.</p></body>
</html>
