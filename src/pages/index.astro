---
import Mark from '../components/Mark.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroPanel from '../components/HeroPanel.astro';
import PriceTrackerMock from '../components/PriceTrackerMock.astro';
import Clients from '../components/Clients.astro';
import CtaBand from '../components/CtaBand.astro';
import { stats, bookingLink, site } from '../data/site';
import { url } from '../lib/url';

const lines = [
  {
    key: 'consulting', icon: 'chart', name: 'Consulting', kicker: 'Asesoría y proyectos',
    title: 'Business Intelligence que tu gerencia sí usa.',
    text: 'Dashboards ejecutivos, modelado de datos e integración de sistemas con Power BI, del diagnóstico al soporte.',
    points: ['Proyecto completo en ~6 semanas', 'Por horas o con soporte mensual', 'Propuesta comercial descargable'],
    cta: 'Ir a Consulting', href: 'consulting/',
  },
  {
    key: 'academy', icon: 'graduation', name: 'Academy', kicker: 'Cursos y capacitación',
    title: 'Aprende Power BI con quienes lo implementan.',
    text: 'Programas de 2 meses con clases en vivo y virtuales, casos reales y proyecto final.',
    points: ['3 niveles: inicial, intermedio y avanzado', 'Para personas, empresas y universidades', 'Desde Bs 800 por persona en grupo'],
    cta: 'Ir a Academy', href: 'academy/',
  },
  {
    key: 'talks', icon: 'mic', name: 'Talks', kicker: 'Comunidad · Próximamente',
    title: 'Conversaciones sobre datos e IA, hechas en Bolivia.',
    text: 'Conferencias, eventos y videos con casos reales de analítica, IA aplicada y transformación digital.',
    points: ['Conferencias y meetups', 'Videos y entrevistas', 'Lista de espera abierta'],
    cta: 'Ir a Talks', href: 'talks/',
  },
] as const;
---
<Base>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-deco" aria-hidden="true"><span class="c1"></span><span class="c2"></span><span class="blob"></span><span class="blob b2"></span></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="badge-line"><Mark size={22} />Consulting · Academy · Talks</p>
        <h1 id="hero-title" data-split>Transformamos datos en <span class="gradient-text">decisiones inteligentes</span></h1>
        <p class="lead reveal">Prometeo ayuda a empresas y personas a decidir con datos: implementamos Business Intelligence, formamos equipos y compartimos lo que aprendemos.</p>
        <div class="btn-row reveal">
          <a class="btn btn-primary" href={bookingLink()}><Icon name="calendar" />Agendar reunión</a>
          <a class="btn btn-ghost" href="#lineas">Conocer Prometeo<Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="hero-visual">
        <HeroPanel />
        <span class="float f1 reveal"><Mark brand="consulting" size={20} />Consulting</span>
        <span class="float f2 reveal"><Mark brand="academy" size={20} />Academy</span>
        <span class="float f3 reveal"><Mark brand="talks" size={20} />Talks · pronto</span>
      </div>
    </div>
  </section>

  <!-- LÍNEAS (sticky storytelling) -->
  <section id="lineas" class="story" data-story aria-labelledby="story-title">
    <div class="container">
      <header class="story-head">
        <p class="eyebrow"><Icon name="layers" />Una sola marca</p>
        <h2 id="story-title" class="section-title" data-split="scroll">Prometeo, en tres frentes.</h2>
        <p class="section-lead">Cada línea tiene su espacio, pero todas comparten lo mismo: experiencia real con datos.</p>
      </header>
      <div class="story-grid">
        <div class="story-visual" aria-hidden="true">
          <div class="stage">
            <!-- Consulting -->
            <div class="vis v-consulting" data-visual>
              <div class="vc-top"><span></span><span></span><span></span></div>
              <div class="vc-kpis"><b>Bs 4,2 M</b><b>34,6 %</b><b>1.840</b></div>
              <div class="vc-bars">{[40, 62, 50, 78, 70, 90, 84].map((h) => <i style={`height:${h}%`}></i>)}</div>
              <p class="vis-label">Dashboard ejecutivo</p>
            </div>
            <!-- Academy -->
            <div class="vis v-academy" data-visual>
              <p class="va-k">Analítica de datos con Power BI</p>
              <ul>
                <li class="done"><span>M1</span>Power Query<em>✓</em></li>
                <li class="done"><span>M2</span>Modelado y DAX<em>✓</em></li>
                <li class="now"><span>M3</span>Dashboards<em>En curso</em></li>
                <li><span>M4</span>Publicación y proyecto</li>
              </ul>
              <div class="va-chips"><b>En vivo</b><b>Virtual</b><b>1,5 h</b></div>
              <p class="vis-label">Ruta de 2 meses</p>
            </div>
            <!-- Talks -->
            <div class="vis v-talks" data-visual>
              <p class="vt-k">Prometeo Talks</p>
              <p class="vt-n">#01</p>
              <p class="vt-t">Datos e IA en la empresa boliviana</p>
              <div class="vt-row"><span>Santa Cruz</span><span>Próximamente</span></div>
              <div class="vt-wave">{Array.from({ length: 24 }).map((_, i) => <i style={`height:${20 + ((i * 37) % 70)}%`}></i>)}</div>
            </div>
          </div>
        </div>
        <ol class="steps">
          {lines.map((l, i) => (
            <li class={`step s-${l.key}`} data-step>
              <p class="kicker"><span class="ico"><Mark brand={l.key} size={22} /></span>Prometeo {l.name} · {l.kicker}</p>
              <h3>{l.title}</h3>
              <p class="txt">{l.text}</p>
              <ul class="pts">{l.points.map((p) => <li><Icon name="check" size={16} />{p}</li>)}</ul>
              <a class="go" href={url(l.href)}>{l.cta}<Icon name="arrow-right" size={18} /></a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- CIFRAS -->
  <section class="stats" aria-label="Trayectoria">
    <div class="container">
      <dl class="stats-grid">
        {stats.map((s) => (
          <div class="reveal">
            <dd>{s.count !== null ? <span data-count={s.count} data-prefix={s.prefix}>{s.prefix}{s.count}</span> : s.text}</dd>
            <dt>{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Clients />

  <!-- PROYECTO: PRECIO JUSTO BY PROMETEO -->
  <section class="project" aria-labelledby="pj-title">
    <div class="container">
      <p class="proj-k reveal">Proyectos Prometeo</p>
      <div class="pj-card">
        <div class="pj-copy reveal">
          <p class="pj-badge"><Mark brand="precio" size={20} />Precio Justo <span>by prometeo</span></p>
          <h2 id="pj-title">Además de asesorar, construimos productos.</h2>
          <p>Precio Justo compara automáticamente los precios de Fidalga, Hipermaxi, Amarket, Farmacorp y Farmacias Chávez, producto por producto.</p>
          <div class="btn-row">
            <a class="btn pj-btn" href={site.precioJustoUrl} target="_blank" rel="noopener"><Icon name="search" />Buscar precios</a>
            <a class="btn btn-ghost" href={url('precio-justo/')}>Conocer el proyecto<Icon name="arrow-right" /></a>
          </div>
        </div>
        <div class="pj-mock" data-parallax="6"><PriceTrackerMock compact /></div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* HERO */
  .hero { background: var(--hero-grad); color: #fff; position: relative; overflow: hidden; padding: 150px 0 120px; min-height: min(100vh, 900px); display: flex; align-items: center; }
  .hero-deco span { position: absolute; border-radius: 50%; pointer-events: none; }
  .c1 { width: 760px; height: 760px; top: -240px; right: -180px; border: 1px solid rgb(var(--accent-rgb) / .2); }
  .c2 { width: 500px; height: 500px; top: -110px; right: 40px; border: 1px solid rgb(var(--accent-rgb) / .1); }
  .blob { width: 720px; height: 720px; bottom: -320px; left: -260px; background: radial-gradient(circle, rgb(var(--accent-rgb) / .38), transparent 65%); }
  .blob.b2 { width: 560px; height: 560px; top: -5%; left: 35%; bottom: auto; background: radial-gradient(circle, rgb(var(--accent-rgb) / .2), transparent 65%); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 56px; align-items: center; position: relative; }
  .hero h1 { font-size: clamp(40px, 5.6vw, 68px); font-weight: 800; letter-spacing: -2px; line-height: 1.04; }
  .hero .lead { font-size: 19px; color: rgba(255,255,255,.75); max-width: 520px; margin: 24px 0 36px; line-height: 1.7; }
  .hero-visual { position: relative; perspective: 1400px; }
  .float { position: absolute; display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--charcoal); font-size: 14px; font-weight: 600; padding: 11px 18px; border-radius: 50px; box-shadow: 0 14px 34px rgba(0,0,0,.28); }
  .f1 { top: -22px; left: 8%; } .f1 :global(svg) { color: var(--c-consulting); }
  .f2 { bottom: 26%; left: -24px; } .f2 :global(svg) { color: var(--c-academy); }
  .f3 { bottom: -22px; right: 6%; } .f3 :global(svg) { color: var(--c-talks); }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; } .f2 { left: 8px; } }

  /* STORY */
  .story { padding: 120px 0 40px; background: #fff; }
  .story-head { text-align: center; max-width: 720px; margin: 0 auto 64px; }
  .story-head .section-lead { margin-left: auto; margin-right: auto; }
  .story-head .section-title { font-size: clamp(36px, 5vw, 60px); letter-spacing: -2px; }
  .story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .story-visual { position: relative; }
  .stage { position: sticky; top: 18vh; height: 64vh; min-height: 440px; max-height: 560px; border-radius: 32px; background: #F6F5FB; overflow: hidden; transition: background .6s var(--ease-out); }
  [data-active='0'] .stage { background: linear-gradient(160deg, #EDE7F6, #F8F6FE); }
  [data-active='1'] .stage { background: linear-gradient(160deg, #E3E9FF, #F5F7FF); }
  [data-active='2'] .stage { background: linear-gradient(160deg, #FFE8D9, #FFF7F1); }
  .vis { position: absolute; inset: 12% 12%; border-radius: 22px; background: #fff; box-shadow: 0 30px 70px rgba(30,27,46,.14); padding: 22px; opacity: 0; transform: translateY(30px) scale(.96); transition: opacity .6s var(--ease-out), transform .8s var(--ease-out); display: flex; flex-direction: column; gap: 14px; }
  .vis.is-active { opacity: 1; transform: none; }
  .vis-label { margin-top: auto; font-size: 12px; font-weight: 600; color: var(--gray-mid); }
  .vc-top { display: flex; gap: 6px; } .vc-top span { width: 10px; height: 10px; border-radius: 50%; background: #E2DAF8; }
  .vc-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .vc-kpis b { background: #F4F1FC; border-radius: 12px; padding: 14px 10px; font-family: var(--font-display); font-size: 18px; color: #3D1E9E; }
  .vc-bars { flex: 1; display: flex; align-items: flex-end; gap: 8px; background: #F4F1FC; border-radius: 14px; padding: 14px; }
  .vc-bars i { flex: 1; border-radius: 6px 6px 0 0; background: linear-gradient(180deg, #9B6EFF, #7C4DFF); }
  .va-k { font-family: var(--font-display); font-weight: 700; font-size: 17px; color: #1E3398; }
  .v-academy ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .v-academy li { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; background: #F1F4FF; font-size: 14px; color: #263159; }
  .v-academy li span { font-size: 11px; font-weight: 700; color: #3B5BDB; background: #fff; border-radius: 8px; padding: 3px 7px; }
  .v-academy li em { margin-left: auto; font-style: normal; font-size: 12px; font-weight: 600; color: #3B5BDB; }
  .v-academy li.now { background: #3B5BDB; color: #fff; } .v-academy li.now em { color: #fff; }
  .va-chips { display: flex; gap: 6px; } .va-chips b { font-size: 12px; padding: 5px 10px; border-radius: 99px; background: #E7ECFF; color: #2F4AC0; }
  .v-talks { background: linear-gradient(160deg, #2A1206, #5A2309); color: #fff; }
  .vt-k { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #FFA94D; }
  .vt-n { font-family: var(--font-display); font-weight: 800; font-size: 72px; line-height: 1; letter-spacing: -3px; }
  .vt-t { font-family: var(--font-display); font-size: 20px; font-weight: 700; max-width: 260px; }
  .vt-row { display: flex; gap: 8px; } .vt-row span { font-size: 12px; padding: 5px 10px; border-radius: 99px; border: 1px solid rgba(255,255,255,.3); }
  .vt-wave { margin-top: auto; display: flex; align-items: center; gap: 4px; height: 60px; }
  .vt-wave i { flex: 1; border-radius: 4px; background: linear-gradient(180deg, #FFA94D, #F76707); animation: wave 1.4s ease-in-out infinite alternate; }
  .vt-wave i:nth-child(3n) { animation-delay: .2s; } .vt-wave i:nth-child(4n) { animation-delay: .45s; }
  @keyframes wave { to { transform: scaleY(.45); } }

  .steps { list-style: none; padding: 0; margin: 0; }
  .step { min-height: 72vh; display: flex; flex-direction: column; justify-content: center; gap: 16px; opacity: .3; transition: opacity .5s var(--ease-out); --c: var(--c-consulting); --cbg: var(--c-consulting-bg); }
  .step.is-active { opacity: 1; }
  .no-js .step, .step:only-child { opacity: 1; }
  .s-academy { --c: var(--c-academy); --cbg: var(--c-academy-bg); }
  .s-talks { --c: var(--c-talks); --cbg: var(--c-talks-bg); }
  .kicker { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 700; letter-spacing: .5px; color: var(--c); }
  .ico { width: 36px; height: 36px; border-radius: 10px; background: var(--cbg); display: inline-flex; align-items: center; justify-content: center; }
  .step h3 { font-size: clamp(30px, 3.6vw, 46px); font-weight: 800; letter-spacing: -1.5px; line-height: 1.08; }
  .txt { font-size: 18px; color: var(--gray-mid); max-width: 480px; }
  .pts { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .pts li { display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--gray-dark); }
  .pts :global(svg) { color: var(--c); }
  .go { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; padding: 13px 24px; min-height: 48px; border-radius: 99px; background: var(--c); color: #fff; font-weight: 600; text-decoration: none; transition: transform var(--trans), box-shadow var(--trans); }
  .go:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 12px 28px color-mix(in srgb, var(--c) 40%, transparent); }
  @media (max-width: 900px) {
    .story-grid { grid-template-columns: 1fr; gap: 0; }
    .story-visual { display: none; }
    .step { min-height: auto; padding: 36px 0; opacity: 1; border-top: 1px solid #EEEAF6; }
  }

  /* STATS */
  .stats { background: linear-gradient(90deg, var(--purple-dark), var(--purple)); color: #fff; padding: 52px 0; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 24px; margin: 0; text-align: center; }
  .stats-grid dd { margin: 0; font-family: var(--font-display); font-size: 48px; font-weight: 800; letter-spacing: -1.5px; font-variant-numeric: tabular-nums; }
  .stats-grid dt { font-size: 14px; color: rgba(255,255,255,.85); }

  /* PROYECTO */
  .project { padding: 40px 0 110px; background: #fff; }
  .proj-k { text-align: center; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gray-mid); margin-bottom: 20px; }
  .pj-card { display: grid; grid-template-columns: 1fr 1.25fr; gap: 48px; align-items: center; background: linear-gradient(150deg, #03201A, #08463A 60%, #0B5C47); border-radius: 36px; padding: clamp(32px, 5vw, 64px); color: #fff; overflow: hidden; }
  .pj-badge { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 99px; background: rgba(99,230,190,.15); border: 1px solid rgba(99,230,190,.4); color: #B2F2DA; font-size: 13px; font-weight: 700; margin-bottom: 20px; }
  .pj-badge span { font-weight: 500; opacity: .8; }
  .pj-copy h2 { font-size: clamp(28px, 3.4vw, 42px); font-weight: 800; letter-spacing: -1.2px; }
  .pj-copy p:not(.pj-badge) { color: rgba(255,255,255,.78); font-size: 17px; margin: 16px 0 28px; }
  .pj-btn { background: #12B886; color: #03201A; }
  .pj-btn:hover { background: #63E6BE; color: #03201A; transform: translateY(-3px); }
  @media (max-width: 960px) { .pj-card { grid-template-columns: 1fr; } }
</style>
