---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { url } from '../lib/url';
const lines = [
  { brand: 'consulting', label: 'Consulting', href: 'consulting/' },
  { brand: 'academy', label: 'Academy', href: 'academy/' },
  { brand: 'talks', label: 'Talks', href: 'talks/' },
  { brand: 'precio', label: 'Precios Claros', href: 'precios-claros/' },
] as const;
---
<Base title="Página no encontrada" description="Esta página no existe. Vuelve al inicio de Prometeo.">
  <section class="nf">
    <div class="container inner">
      <Mark size={120} class="mk" label="Llama de Prometeo" />
      <h1>Esta página se apagó.</h1>
      <p>El enlace que seguiste no existe o cambió de lugar. Elige a dónde ir:</p>
      <ul>
        {lines.map((l) => <li><a href={url(l.href)}><Mark brand={l.brand} size={28} />{l.label}</a></li>)}
      </ul>
      <a class="btn btn-primary" href={url('')}>Volver al inicio</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 100vh; display: flex; align-items: center; background: var(--hero-grad); color: #fff; padding: 140px 0 80px; }
  .inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; }
  .nf :global(.mk) { filter: drop-shadow(0 0 40px rgba(124, 77, 255, .5)); }
  h1 { font-size: clamp(36px, 6vw, 64px); letter-spacing: -2px; }
  p { color: rgba(255, 255, 255, .75); max-width: 460px; }
  ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 8px 0 12px; padding: 0; }
  ul a { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 999px; background: rgba(255, 255, 255, .08); color: #fff; text-decoration: none; font-weight: 600; transition: background var(--trans); }
  ul a:hover { background: rgba(255, 255, 255, .16); }
</style>
